{
  "name": "log-scrub-contract-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "test": "cargo test --locked && npm run test:site",
    "test:site": "vitest run --config site/vite.config.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "build": "npm run build:cli && npm run build:site && npm run copy:binary",
    "build:cli": "cargo build --release --locked",
    "build:site": "vite build --config site/vite.config.ts",
    "copy:binary": "node scripts/copy-binary.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "playwright": "^1.58.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
